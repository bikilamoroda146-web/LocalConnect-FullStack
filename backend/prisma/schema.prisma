// LocalConnect database schema.
// Milestone 1 intentionally contains NO models yet; they arrive in Milestone 2.
// The connection URL is not stored here. In Prisma 7 it lives in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum ReportTargetType {
  SERVICE
  PROVIDER
  REVIEW
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  phone        String?
  area         String?
  avatarKey    String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  providerProfile   ProviderProfile?
  customerBookings  Booking[]          @relation("CustomerBookings")
  reviews           Review[]           @relation("ReviewerReviews")
  serviceFavorites  FavoriteService[]
  providerFavorites FavoriteProvider[]
  reportsCreated    Report[]           @relation("ReporterReports")
  reportsResolved   Report[]           @relation("ResolverReports")

  @@index([role, status])
  @@index([area])
}

model ProviderProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  profession String
  category   String
  area       String
  years      Int
  bio        String
  skills     String[]
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  services     Service[]
  bookings     Booking[]          @relation("ProviderBookings")
  reviews      Review[]
  availability AvailabilitySlot[]
  portfolio    Portfolio?
  favorites    FavoriteProvider[]
  reports      Report[]

  @@index([category, area])
  @@index([verified])
}

model Service {
  id          String   @id @default(cuid())
  providerId  String
  title       String
  category    String
  area        String
  description String
  price       Decimal  @db.Decimal(12, 2)
  priceUnit   String
  includes    String[]
  imageKey    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  provider  ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  bookings  Booking[]
  favorites FavoriteService[]
  reports   Report[]

  @@unique([id, providerId])
  @@index([providerId, published])
  @@index([category, area, published])
  @@index([price])
}

model Booking {
  id         String        @id @default(cuid())
  serviceId  String
  providerId String
  customerId String
  date       DateTime      @db.Date
  time       DateTime      @db.Time(0)
  note       String?
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)

  service  Service         @relation(fields: [serviceId, providerId], references: [id, providerId], onDelete: Restrict)
  provider ProviderProfile @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Restrict)
  customer User            @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  review   Review?

  @@index([customerId, status])
  @@index([providerId, status])
  @@index([date, status])
}

model Review {
  id         String   @id @default(cuid())
  providerId String
  reviewerId String?
  bookingId  String?  @unique
  authorName String?
  rating     Int
  text       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  reviewer User?           @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: SetNull)
  booking  Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  reports  Report[]

  @@index([providerId, createdAt])
}

model FavoriteService {
  userId    String
  serviceId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
  @@index([serviceId])
}

model FavoriteProvider {
  userId     String
  providerId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([userId, providerId])
  @@index([providerId])
}

model AvailabilitySlot {
  id         String   @id @default(cuid())
  providerId String
  dayOfWeek  Int
  startTime  DateTime @db.Time(0)
  endTime    DateTime @db.Time(0)
  enabled    Boolean  @default(true)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, dayOfWeek])
}

model Portfolio {
  id              String   @id @default(cuid())
  providerId      String   @unique
  coverStorageKey String?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  provider ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  projects PortfolioProject[]
}

model PortfolioProject {
  id          String    @id @default(cuid())
  portfolioId String
  title       String
  description String
  category    String
  completedAt DateTime? @db.Date
  location    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  portfolio Portfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  photos    PortfolioPhoto[]

  @@index([portfolioId, sortOrder])
}

model PortfolioPhoto {
  id         String   @id @default(cuid())
  projectId  String
  storageKey String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  project PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model Report {
  id           String           @id @default(cuid())
  targetType   ReportTargetType
  serviceId    String?
  providerId   String?
  reviewId     String?
  reporterId   String?
  reason       String
  status       ReportStatus     @default(OPEN)
  resolvedById String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?        @db.Timestamptz(3)

  service    Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  provider   ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  review     Review?          @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  reporter   User?            @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User?            @relation("ResolverReports", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType])
}
