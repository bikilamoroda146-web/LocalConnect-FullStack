{
  "name": "localconnect-backend",
  "version": "0.1.0",
  "private": true,
  "description": "LocalConnect REST API (Express + PostgreSQL + Prisma)",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-db.js",
    "db:seed:dev": "node scripts/seed-dev.js",
    "db:setup-admin:dev": "node scripts/setup-admin-dev.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
