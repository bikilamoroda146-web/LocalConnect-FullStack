# Copy this file to ".env" (same folder) and edit the values. NEVER commit ".env".
# Every value below is a placeholder, not a real credential.

NODE_ENV=development

# Where the API listens. 127.0.0.1 = only this computer can reach it (safest for development).
HOST=127.0.0.1
PORT=5000

# PostgreSQL connection string:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains special characters (@ : / # ? %), percent-encode them (e.g. @ becomes %40).
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5000/localconnect_dev"

# At least 32 random characters. Used to sign authentication cookies.
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Frontend addresses allowed to call this API from a browser (comma-separated, no trailing path).
# The Vite dev server uses http://localhost:5173 by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional development-only first administrator setup. Keep these values local and
# run `npm run db:setup-admin:dev`; the script refuses to run in production.
# DEV_ADMIN_NAME=LocalConnect Administrator
# DEV_ADMIN_EMAIL=admin@localconnect.test
# DEV_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_LOCAL_PASSWORD
